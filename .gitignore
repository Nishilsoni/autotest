# Dependencies
node_modules/

# Environment variables (contains credentials)
.env

# Test artifacts (generated dynamically)
# NOTE: playwright-report/ is intentionally committed — it's the HTML report
# + embedded video deliverable required for submission. Only test-results/
# (raw per-run traces/screenshots, regenerated every run) stays ignored.
test-results/

# OS-specific files
.DS_Store
Thumbs.db

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# TypeScript build output
dist/

# Coverage
coverage/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
